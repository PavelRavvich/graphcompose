# Copy to .env — used by `npm start`, `npm run studio` and `make smoke`. Never by unit tests or CI.
OPENROUTER_API_KEY=
# Optional override (proxy, local OpenAI-compatible server)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Daily spend ledger of the agent bundle (outside the repo). Default: ~/.langgraph-agents/spend
# SPEND_LEDGER_DIR=

# Router (Jev) and agent models (Kimi) live in src/config/agents.config.ts, not here.
# Jev uses the same key via OpenRouter's Decisions API (/api/alpha/decisions).

# Optional tracing (LangSmith): per-call traces, latency, tokens
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=langgraph-ts-template

# Optional: trace runs into a self-hosted Langfuse (Wiki → Tracing). Unset = no tracing.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=http://localhost:3000
