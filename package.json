{
  "name": "langgraph-ts-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "smoke": "vitest run --config vitest.smoke.config.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run coverage",
    "studio": "langgraphjs dev",
    "test:routers": "vitest run tests/routers",
    "test:tools": "vitest run tests/tools",
    "eval": "tsx src/eval/cli.ts eval",
    "replay": "tsx src/eval/cli.ts replay",
    "chat": "tsx src/chat.ts",
    "job-scout:probe": "tsx src/demos/job-scout/probe-boards.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.12",
    "@langchain/langgraph": "^1.4.17",
    "@langchain/openai": "^1.5.13",
    "@langfuse/langchain": "^5.11.1",
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "dotenv": "^18.0.3",
    "langchain": "^1.5.12",
    "langsmith": "^0.10.5",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@langchain/langgraph-cli": "^1.0.0",
    "@modelcontextprotocol/server-filesystem": "^2026.8.31",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
