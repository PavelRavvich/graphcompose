{
  "name": "graphinject-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w graphinject",
    "dev": "npm run dev -w graphinject",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces",
    "coverage": "npm run coverage --workspaces",
    "check": "npm run build && npm run format:check && npm run lint && npm run typecheck && npm run coverage",
    "smoke": "npm run smoke -w graphinject",
    "studio": "npm run build && langgraphjs dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@langchain/langgraph-cli": "^1.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
