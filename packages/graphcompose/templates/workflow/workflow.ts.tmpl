import { Workflow } from "graphcompose/core";
import { WorkflowSettings, type WorkflowDefinition } from "graphcompose/core";
import { from } from "graphcompose/router";
import { JevModelProvider } from "graphcompose/models";
import { usd } from "graphcompose/units";
import { OpenRouterModelProvider } from "./model-providers/openrouter.model-provider.js";
import { TextWorkflowStart } from "./workflow-starts/text.workflow-start.js";
import { TextWorkflowFinish } from "./workflow-finishes/text.workflow-finish.js";
import { MainRouter } from "./routers/main.router.js";
{{imports}}

/** {{title}} — generated by `gc create`; every setting below is yours to change. */
@Workflow({
  name: "{{kebab}}",
  version: "0.1.0",
  // the graph: the text goes to the main router, which picks an agent or finishes the run
  flow: [
    from(TextWorkflowStart).next(MainRouter),
    from(MainRouter).routeOne({{agents}}, TextWorkflowFinish),
    from({{agents}}).next(MainRouter),
  ],
  defaults: {
    // reasoning and caching: the model provider's (model-providers/), an agent may override them
    models: { temperature: 0 },
    router: { kind: "jev", model: "typesafe/jev-1.13" },
    tools: { maxToolCalls: 8 },
    history: { limit: 8 },
  },
  guards: {
    input: { prompt_injection: { threshold: 0.7, refusal: "I can't help with that request." } },
    output: { pii: { threshold: 0.7, refusal: "The answer contained personal data and was withheld." } },
  },
  mcp: [{{servers}}],
})
export class {{pascal}}Workflow implements WorkflowDefinition {
  settings(): WorkflowSettings {
    return WorkflowSettings.builder()
      .limits({ perRun: { cost: usd(0.1) }, perDay: { cost: usd(2) } })
      .modelProviders([OpenRouterModelProvider, JevModelProvider])
      .build();
  }
}
