{
  "name": "graphcompose",
  "version": "0.1.0",
  "description": "Typed agent workflows on LangGraph \u2014 Angular-style components, Jev routing, FinOps, evaluation",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "graphcompose": "./bin/graphcompose.js",
    "gc": "./bin/graphcompose.js"
  },
  "files": [
    "bin",
    "dist",
    "schema",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "smoke": "vitest run --config vitest.smoke.config.ts",
    "schema": "tsx src/config/write-profile-schema.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.12",
    "@langchain/langgraph": "^1.4.17",
    "@langchain/openai": "^1.5.13",
    "@langfuse/langchain": "^5.11.1",
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "dotenv": "^18.0.3",
    "langchain": "^1.5.12",
    "langsmith": "^0.10.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/server-filesystem": "^2026.8.31"
  }
}
