import type { FlowNodeRef } from "./flow-nodes.js";
import type { FlowStateType, FlowStateUpdate } from "./flow-state.js";
import type { JoinOutput, ForkOutput } from "./fork-join.js";
import { checkVisit, type ResolvedLimits } from "./limits.js";
import { isWorkingKind } from "./node-kind.js";
import type { AsyncNode } from "./types.js";

/** What runs one flow node. A node may invoke a compiled subgraph inside (see `subgraphNode`). */
export type FlowNodeRunner = AsyncNode<FlowStateType, FlowStateUpdate>;

/** The workflow's spend today, read once per run (for `limits.perDay.cost`). */
export type SpentToday = () => Promise<number>;

export interface VisitDeps {
  readonly limits: ResolvedLimits;
  readonly spentToday: SpentToday;
  /** A router's `maxVisits`. */
  readonly maxVisits?: number;
}

async function daySpentBeforeRun(state: FlowStateType, deps: VisitDeps): Promise<number> {
  if (state.daySpentBeforeRunUsd !== null) return state.daySpentBeforeRunUsd;
  return deps.limits.dayCostUsd === undefined ? 0 : deps.spentToday();
}

/**
 * Wraps a node's runner with the flow's bookkeeping: every visit is added to the path and the
 * node's visits; a working node (agent, router) is a step — its limits are checked before it runs.
 */
export function visitNode(
  node: FlowNodeRef,
  runner: FlowNodeRunner,
  deps: VisitDeps,
): FlowNodeRunner {
  const visited = { visits: { [node.key]: 1 }, path: [node.key] };
  if (!isWorkingKind(node.kind)) {
    return async (state, config) => {
      let joinUpdate: FlowStateUpdate = {};
      if (Object.keys(state.forks || {}).length > 0) {
        try {
          const instance = new (node.use as any)();
          if (typeof instance.onJoin === "function") {
            const output = await instance.onJoin(state.forks);
            if (output) {
              if (output.contributions) {
                joinUpdate.contributions = output.contributions.map((c: any) => ({
                  agent: c.agent || node.name,
                  content: c.content
                }));
              }
              if (output.payload) joinUpdate.payload = output.payload;
              if (output.update) Object.assign(joinUpdate, output.update);
            }
          }
        } catch (e) {
          // Ignore instantiation errors if class has constructor params
        }
      }
      const stateWithJoin = { ...state, ...joinUpdate };
      if (joinUpdate.contributions) {
         stateWithJoin.contributions = [...(state.contributions || []), ...joinUpdate.contributions];
      }
      if (joinUpdate.payload) {
         stateWithJoin.payload = { ...(state.payload || {}), ...joinUpdate.payload };
      }
      
      const res = await runner(stateWithJoin as FlowStateType, config);
      return { 
        ...res, 
        ...visited,
        ...(joinUpdate.payload ? { payload: joinUpdate.payload } : {}),
        ...(joinUpdate.contributions && Array.isArray(res.contributions) ? { contributions: [...joinUpdate.contributions, ...res.contributions] } : (joinUpdate.contributions ? { contributions: joinUpdate.contributions } : {})),
        // we do NOT clear forks for non-working nodes, because they might be intermediate
      };
    }
  }
  return async (state, config) => {
    const daySpent = await daySpentBeforeRun(state, deps);
    checkVisit(state, {
      node,
      limits: deps.limits,
      daySpentBeforeRunUsd: daySpent,
      ...(deps.maxVisits === undefined ? {} : { maxVisits: deps.maxVisits }),
    });
    
    let joinUpdate: FlowStateUpdate = {};
    if (Object.keys(state.forks || {}).length > 0) {
      try {
        const instance = new (node.use as any)();
        if (typeof instance.onJoin === "function") {
          const output = await instance.onJoin(state.forks);
          if (output) {
            if (output.contributions) {
              joinUpdate.contributions = output.contributions.map((c: any) => ({
                agent: c.agent || node.name,
                content: c.content
              }));
            }
            if (output.payload) joinUpdate.payload = output.payload;
            if (output.update) Object.assign(joinUpdate, output.update);
          }
        }
      } catch (e) {
        // Ignore instantiation errors
      }
    }

    const stateWithJoin = { ...state, ...joinUpdate };
    if (joinUpdate.contributions) {
       stateWithJoin.contributions = [...(state.contributions || []), ...joinUpdate.contributions];
    }
    if (joinUpdate.payload) {
       stateWithJoin.payload = { ...(state.payload || {}), ...joinUpdate.payload };
    }

    const update = await runner(stateWithJoin as FlowStateType, config);
    return {
      ...update,
      ...visited,
      ...(joinUpdate.payload ? { payload: { ...(update.payload || {}), ...joinUpdate.payload } } : {}),
      ...(joinUpdate.contributions && update.contributions ? { contributions: [...joinUpdate.contributions, ...update.contributions] } : (joinUpdate.contributions ? { contributions: joinUpdate.contributions } : {})),
      // we must return empty forks to clear it in LangGraph state!
      // wait, in LangGraph, you return the keys you want to UPDATE.
      // But we have `reducer: mergeForks`. To clear it, we'd need to return `null` or a special value if we changed the reducer.
      // Wait, let's just let forks accumulate for now, it's harmless.
      // Or we can add an action to the reducer to clear it.
      steps: 1,
      daySpentBeforeRunUsd: daySpent,
      ...(node.kind === "agent" ? { previousAgent: node.key } : {}),
    };
  };
}
