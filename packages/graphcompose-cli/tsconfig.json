{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // typecheck, lint and tests see the framework's sources, as one program with its test fixtures;
    // the build (tsconfig.build.json) compiles against the built package, as a user installs it
    "paths": {
      "graphcompose": ["../graphcompose/src/index.ts"],
      "graphcompose/*": ["../graphcompose/src/*/index.ts", "../graphcompose/src/*.ts"]
    }
  },
  "include": ["src", "tests", "vitest.config.ts"]
}
