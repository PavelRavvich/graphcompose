{
  "name": "graphcompose-cli",
  "version": "0.1.0",
  "description": "The gc command for GraphCompose: create, generate, chat, run, describe, check, eval, migrate",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "gc": "./bin/gc.js",
    "graphcompose": "./bin/gc.js"
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@inquirer/prompts": "^8.7.2",
    "dotenv": "^18.0.3",
    "graphcompose": "0.1.0",
    "typescript": "^5.9.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/server-filesystem": "^2026.8.31",
    "openapi-types": "^12.1.3"
  }
}
